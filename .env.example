# ========================================================================
# Hotel Booking Management System — Monorepo Environment Configuration
# ========================================================================
# This project uses separate environment configuration files:
#
# 1. Backend:  backend/.env        (copy from backend/.env.example)
# 2. Frontend: frontend/.env.local (copy from frontend/.env.example)
#
# Below is a quick-reference guide of all supported environment variables.
# ========================================================================

# ------------------------------------------------------------------------
# BACKEND (backend/.env)
# ------------------------------------------------------------------------
# Required:
# PORT=5001
# NODE_ENV=development
# MONGODB_CONNECTION_STRING=mongodb://localhost:27017/hotel-booking-local
# JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
# FRONTEND_URL=http://localhost:5174

# Optional / External Integrations:
# STRIPE_API_KEY=sk_test_placeholder_for_local_demo
# CLOUDINARY_CLOUD_NAME=demo
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# BACKEND_URL=http://localhost:5001

# ------------------------------------------------------------------------
# FRONTEND (frontend/.env.local)
# ------------------------------------------------------------------------
# Required:
# VITE_API_BASE_URL=http://localhost:5001

# Optional:
# VITE_STRIPE_PUB_KEY=pk_test_placeholder_for_local_demo

