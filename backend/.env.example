# ========================================================================
# Hotel Booking Backend — Environment Configuration
# ========================================================================
# Copy this file to .env:
#   cp .env.example .env
# ========================================================================

# ------------------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------------------
# Canonical local port (must match frontend VITE_API_BASE_URL)
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------
# Local MongoDB instance or MongoDB Atlas connection string
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/hotel-booking-local

# ------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------
# Secure secret key for signing JWT tokens (min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars

# ------------------------------------------------------------------------
# CORS & FRONTEND COMMUNICATION
# ------------------------------------------------------------------------
# Allowed frontend origin for CORS cookies & requests
FRONTEND_URL=http://localhost:5174

# Public backend URL (used for OAuth redirects and Swagger)
BACKEND_URL=http://localhost:5001

# ------------------------------------------------------------------------
# OPTIONAL: STRIPE PAYMENTS (Test Mode)
# ------------------------------------------------------------------------
# If omitted or left as placeholder, the system defaults to simulated payments
STRIPE_API_KEY=sk_test_placeholder_for_local_demo

# ------------------------------------------------------------------------
# OPTIONAL: CLOUDINARY MEDIA STORAGE
# ------------------------------------------------------------------------
# If omitted or set to "demo", the system falls back to Unsplash imagery
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------
# OPTIONAL: GOOGLE OAUTH
# ------------------------------------------------------------------------
# GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_SECRET=your_google_client_secret
